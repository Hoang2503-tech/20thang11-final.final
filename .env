# Dear WIB — Environment Variables
# ─────────────────────────────────
# 1. Go to https://supabase.com → your project → Settings → API
# 2. Copy "Project URL" and paste below as VITE_SUPABASE_URL
# 3. Copy "anon / public" key and paste below as VITE_SUPABASE_ANON_KEY
# 4. NEVER paste the "service_role" key here — it belongs only on a server
# 5. After editing, restart "npm run dev" for changes to take effect

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...replace_this
